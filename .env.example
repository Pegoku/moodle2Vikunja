# Moodle (IEDIB aula virtual)
MOODLE_URL=https://iedib.net/avirtual
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Vikunja: either an API token (Settings > API Tokens, needs tasks/projects/labels access)
# or username + password.
VIKUNJA_URL=https://try.vikunja.io
VIKUNJA_TOKEN=
VIKUNJA_USERNAME=
VIKUNJA_PASSWORD=

# Project that receives the tasks (created if missing)
VIKUNJA_PROJECT=Moodle

# Calendar window to sync, in months around the current month
LOOKBACK_MONTHS=3
LOOKAHEAD_MONTHS=12

# Optional: AI categories + priorities (OpenAI). Leave the key empty to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Any OpenAI-compatible endpoint works (e.g. https://openrouter.ai/api/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# Categories suggested to the model; it may add more when nothing fits
AI_CATEGORIES=Task,Quiz,Exam,Video Call,Milestone
